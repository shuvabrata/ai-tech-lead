{
    "python.analysis.extraPaths": [
        "./src"
    ],
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "zsh",
            "args": ["-c", "set -a; source ${workspaceFolder}/.env 2>/dev/null; set +a; exec zsh"]
        }
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "chat.tools.terminal.autoApprove": {
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && git remote show origin \\| grep HEAD \\| awk '\\{print \\$NF\\}'$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && git merge-base origin/main HEAD$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && git diff --name-only \\$\\(git merge-base origin/main HEAD\\)\\.\\.HEAD$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && git log --oneline \\$\\(git merge-base origin/main HEAD\\)\\.\\.HEAD$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && git diff \\$\\(git merge-base origin/main HEAD\\)\\.\\.HEAD --stat$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && rtk git diff \\$\\(git merge-base origin/main HEAD\\)\\.\\.HEAD$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cd /home/shuva/github/shuvabrata/work-behavior-analytics-ai && rtk git log --oneline main -5$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "git merge-base": true
    }
}